# FlowInsight Environment Configuration Example
# NOTICE: Synthetic data generated for demonstration. Not real EDA tool logs.

# Environment mode (development / production)
ENVIRONMENT=development

# Server Configuration
PORT=8000
HOST=127.0.0.1

# Database and Model Artifact Storage Paths
FLOWINSIGHT_DB_PATH=data/flowinsight.db
FLOWINSIGHT_MODELS_DIR=models_saved

# Optional API Security (Leave blank for open access; set to require X-API-Key header)
FLOWINSIGHT_API_KEY=

# CORS Allowed Origins (Comma-separated, no wildcards allowed in production)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional LLM Summarizer (Disabled by default; set API key to enable)
LLM_API_KEY=
LLM_PROVIDER_URL=https://api.openai.com/v1/chat/completions
